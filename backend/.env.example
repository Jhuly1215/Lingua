# ==============================================================================
# LINGUA - Configuración de Entorno (Variables de Ejemplo)
# ==============================================================================
# IMPORTANTE: No incluyas credenciales reales en este archivo ni en el control de versiones.
# Copia este archivo a `.env` y completa con las credenciales obtenidas de tu proyecto Supabase.

# --- Aplicación ---
APP_NAME="LINGUA Backend API"
APP_ENV="development" # development | testing | staging | production
API_V1_PREFIX="/api/v1"
DEBUG=true
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- CORS (Orígenes permitidos separados por comas o lista JSON) ---
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# --- Conexión PostgreSQL (Supabase) ---
# En el panel de Supabase: Project Settings -> Database -> Connection string
# Para FastAPI con SQLAlchemy async: utiliza el driver postgresql+asyncpg://
# Para Alembic (migraciones): utiliza postgresql+psycopg:// o postgresql://
#
# Modo Sesión / Conexión directa (Puerto 5432):
# DATABASE_URL="postgresql+asyncpg://postgres:[TU_PASSWORD]@[TU_HOST]:5432/postgres"
#
# Modo Pooler Transaccional (Puerto 6543):
# Si utilizas PgBouncer en puerto 6543, asyncpg requiere deshabilitar el caché de sentencias preparadas:
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT_REF]:[TU_PASSWORD]@[POOLER_HOST]:6543/postgres?prepared_statement_cache_size=0"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/lingua_db"

# Para pruebas locales aisladas o SQLite de desarrollo sin Postgres:
# DATABASE_URL="sqlite+aiosqlite:///./test_lingua.db"

# --- Supabase Configuración ---
# En el panel de Supabase: Project Settings -> API
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Autenticación y JWT (Supabase Auth) ---
# Supabase por defecto emite tokens con audience "authenticated"
JWT_AUDIENCE="authenticated"
# El secreto JWT se encuentra en: Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-keep-safe"
JWT_ALGORITHM="HS256"
